{
	"manifest_version": 3,
	"name": "CyberGuard Website Monitor",
	"version": "0.1.0",
	"description": "Monitors visited websites and checks their URLs with CyberGuard.",
	"permissions": ["tabs", "storage"],
	"host_permissions": ["http://localhost:5173/*", "http://127.0.0.1:5173/*", "http://localhost:8000/*"],
	"content_scripts": [
		{
			"matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"action": {
		"default_popup": "popup/popup.html",
		"default_title": "CyberGuard Website Monitor",
		"default_icon": {
			"16": "icon.png",
			"32": "icon.png",
			"48": "icon.png",
			"128": "icon.png"
		}
	},
	"icons": {
		"16": "icon.png",
		"32": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	}
}
