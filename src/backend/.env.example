# Copy this file to .env in the same folder and fill in the values below.
# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match a redirect URI registered on that OAuth client in
# Google Cloud Console. The default below is correct for local dev.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback

# The frontend origin allowed to talk to this backend (CORS + OAuth return check).
FRONTEND_ORIGIN=http://localhost:5173

# How long a Gmail session stays logged in, in minutes.
SESSION_TTL_MINUTES=30
